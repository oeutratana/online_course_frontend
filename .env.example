# Copy this file to .env and adjust the values for your environment.
# The Laravel backend must be running and reachable.

# Base URL of the Laravel backend (no trailing slash)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Laravel API base URL (the /api prefix)
VITE_API_URL=http://127.0.0.1:8000/api

# Absolute backend URL used to start Google OAuth. It must use the same host
# as GOOGLE_REDIRECT_URI in the Laravel .env so the OAuth session cookie is sent.
VITE_GOOGLE_AUTH_URL=http://localhost:8000/api/auth/google/redirect

# PayWay merchant credentials (merchant id, API key, callback secret)
# must NOT be added here. They belong ONLY in the Laravel backend .env file.
# The frontend talks to PayWay exclusively through the Laravel /api/payments endpoints.